---
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { getImage } from "astro:assets";
import profileImg from "../assets/david-profile.png";

const ogImg = await getImage({
  src: profileImg,
  format: "webp",
  width: 1200,
});

const {
  title = "David Urdaneta Studio",
  description = "Diseñador UX/UI & Desarrollador Frontend especializado en crear experiencias digitales que convierten.",
  image,
  showWhatsApp = true,
} = Astro.props;

const canonical =
  Astro.site && Astro.url.pathname !== "/"
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.href : "https://davidurdaneta.com";

const ogImageUrl = image ? new URL(image, siteUrl).href : new URL(ogImg.src, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Urdaneta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Tag Manager -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      (function () {
        var load = function () {
          if (window.__gtmLoaded) return;
          window.__gtmLoaded = true;
          var j = document.createElement("script");
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=GTM-TM5FNKQ3";
          document.head.appendChild(j);
        };
        if (
          "requestIdleCallback" in window &&
          document.readyState !== "complete"
        ) {
          window.addEventListener("load", function () {
            window.requestIdleCallback(load, { timeout: 1500 });
          });
        } else if (document.readyState === "complete") {
          load();
        } else {
          window.addEventListener("load", load);
        }
      })();
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TM5FNKQ3"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
    {showWhatsApp && <WhatsAppButton />}

    <!-- Reveal 3D al hacer scroll -->
    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const hasReveal =
        typeof document !== "undefined" &&
        !!document.querySelector("[data-reveal], [data-reveal-group]");

      if (!reduceMotion && hasReveal) {
        const reveal = async () => {
          const [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
            import("gsap"),
            import("gsap/ScrollTrigger"),
          ]);
          gsap.registerPlugin(ScrollTrigger);

          gsap.utils.toArray("[data-reveal]").forEach((el: HTMLElement) => {
            const delay = parseFloat(el.dataset.revealDelay || "0");
            gsap.from(el, {
              y: 64,
              opacity: 0,
              rotateX: 8,
              transformPerspective: 900,
              duration: 0.9,
              ease: "power3.out",
              delay,
              scrollTrigger: { trigger: el, start: "top 86%", once: true },
            });
          });

          gsap.utils.toArray("[data-reveal-group]").forEach((g: HTMLElement) => {
            const children = g.querySelectorAll("[data-reveal-child]");
            gsap.from(children, {
              y: 70,
              opacity: 0,
              rotateX: 8,
              transformPerspective: 900,
              duration: 0.9,
              ease: "power3.out",
              stagger: 0.12,
              scrollTrigger: { trigger: g, start: "top 85%", once: true },
            });
          });
        };

        const onReady = () => {
          if (document.readyState === "complete") reveal();
          else window.addEventListener("load", reveal);
        };

        if (document.readyState !== "loading") onReady();
        else document.addEventListener("DOMContentLoaded", onReady);
      }
    </script>

    <!-- UTM tracking → mensajes de WhatsApp -->
    <script is:inline>
      (function () {
        const KEYS = ["source", "medium", "campaign", "term", "content"];
        const LABELS = {
          source: "fuente",
          medium: "medio",
          campaign: "campaña",
          term: "término",
          content: "contenido",
        };

        function readUtm() {
          try {
            const params = new URLSearchParams(window.location.search);
            const utm = {};
            let found = false;
            KEYS.forEach((k) => {
              const v = params.get("utm_" + k);
              if (v) {
                utm[k] = v;
                found = true;
              }
            });
            if (found) {
              try {
                sessionStorage.setItem("wa_utm", JSON.stringify(utm));
              } catch (e) {}
              return utm;
            }
            try {
              const stored = sessionStorage.getItem("wa_utm");
              if (stored) return JSON.parse(stored);
            } catch (e) {}
            return null;
          } catch (e) {
            return null;
          }
        }

        function appendUtm(href, utm) {
          try {
            const url = new URL(href);
            const msg = url.searchParams.get("text") || "";
            const parts = [];
            KEYS.forEach((k) => {
              if (utm[k]) parts.push(LABELS[k] + ": " + utm[k]);
            });
            if (!parts.length) return href;
            const suffix = "\n\n(Origen detectado: " + parts.join(" · ") + ")";
            url.searchParams.set("text", msg + suffix);
            return url.toString();
          } catch (e) {
            return href;
          }
        }

        document.addEventListener(
          "click",
          function (e) {
            const el = e.target.closest(
              'a[href^="https://wa.me/"], a[href^="https://api.whatsapp.com/"]',
            );
            if (!el) return;
            const utm = readUtm();
            if (!utm) return;
            if (el.dataset.utmAppended) return;
            el.dataset.utmAppended = "1";
            el.href = appendUtm(el.href, utm);
          },
          true,
        );
      })();
    </script>
  </body>
</html>

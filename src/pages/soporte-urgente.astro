    animation-play-state: paused;
  }
  @keyframes mad-scroll-soporte {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .pulse-red {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff4444;
    animation: blink-red 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes blink-red {

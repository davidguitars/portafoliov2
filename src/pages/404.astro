---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const WA_NUMBER = "56958679252";
const WA_HREF = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(
  "Hola David, llegué a un enlace roto en tu sitio web.",
)}`;
---

<Layout title="404 — Página no encontrada | David Urdaneta" showWhatsApp={false}>
  <Header />

  <main style="min-height: calc(100vh - 56px); display: flex; align-items: center;">
    <section
      style="width: 100%; border-bottom: 1px solid var(--border); background: var(--bg-dark);">
      <div
        style="max-width: var(--max-w); margin: 0 auto; padding: 6rem 1.5rem 5rem; text-align: center;">
        <div
          style="font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: #6B6A65; margin-bottom: 1.5rem;">
          Error [404]
        </div>

        <h1
          style="font-size: clamp(4rem, 12vw, 8rem); font-weight: 600; line-height: 0.95; letter-spacing: -0.04em; color: #F5F4F0; margin-bottom: 1.5rem;">
          Esta página<br />
          <span style="color: #FF4444;">no existe.</span>
        </h1>

        <p
          style="font-size: 1rem; line-height: 1.7; color: #6B6A65; max-width: 44ch; margin: 0 auto 2.5rem;">
          El enlace al que entraste está roto o fue movido. Si buscabas algo
          específico, escríbeme y te ayudo.
        </p>

        <div
          style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a
            href={WA_HREF}
            target="_blank"
            rel="noopener"
            style="display: inline-flex; align-items: center; gap: 0.6rem; background: #FF4444; color: #fff; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 1rem 2rem; text-decoration: none; transition: background 0.15s;"
            class="wa-btn-404">
            <i class="ri-whatsapp-line" style="font-size: 1.1rem;"></i> WhatsApp
          </a>
          <a
            href="/"
            style="display: inline-flex; align-items: center; gap: 0.6rem; background: transparent; color: #6B6A65; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 1rem 2rem; border: 1px solid #2A2A28; text-decoration: none; transition: border-color 0.15s, color 0.15s;"
            class="home-btn-404">
            <i class="ri-arrow-right-line"></i> Volver al inicio
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .wa-btn-404:hover {
    background: #b52424 !important;
  }
  .home-btn-404:hover {
    border-color: #f5f4f0 !important;
    color: #f5f4f0 !important;
  }
</style>
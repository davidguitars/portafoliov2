---
const dims = [
  {
    num: "01",
    name: "Diseño UX/UI",
    desc: "Investigación, wireframes y sistemas de diseño que eliminan fricción y convierten.",
    icon: "ri-pen-nib-line",
  },
  {
    num: "02",
    name: "Desarrollo Frontend",
    desc: "Astro, React y Webflow. Código limpio, rendimiento real y animaciones que enamoran.",
    icon: "ri-code-s-slash-line",
  },
  {
    num: "03",
    name: "Automatización con IA",
    desc: "Flujos con N8N e IA que reducen trabajo manual y escalan tu operación.",
    icon: "ri-robot-2-line",
  },
];
---

<section
  id="experiencia"
  style="border-bottom: 1px solid var(--border); padding: 4.5rem 1.5rem; background: var(--bg-dark);"
  class="showcase3d">
  <div style="max-width: var(--max-w); margin: 0 auto;">
    <div
      class="label-tag"
      style="color: #6B6A65; margin-bottom: 1rem; display: block;">
      [06] · 3 dimensiones de trabajo
    </div>
    <h2
      style="font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 500; color: #F5F4F0; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 3rem;">
      Todo en un mismo<br />
      <span style="color: var(--accent);">plano de profundidad.</span>
    </h2>

    <!-- Escenario 3D -->
    <div class="stage3d" data-tilt-stage>
      <div class="stack3d">
        {
          dims.map((d, i) => (
            <article
              class="panel3d"
              data-dz={i}
              style="background: ${i === 0 ? "var(--accent)" : i === 1 ? "#F5F4F0" : "#141414"};">
              <div
                style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; position: relative; z-index: 1;">
                <span
                  style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 500; color: ${i === 2 ? "#6B6A65" : "var(--ink)"};">
                  [{d.num}]
                </span>
                <i
                  class={d.icon}
                  style="font-size: 1.15rem; color: ${i === 2 ? "var(--accent)" : "var(--ink)"};"
                ></i>
              </div>
              <h3
                style="font-family: var(--font-mono); font-size: 1.25rem; font-weight: 500; color: ${i === 2 ? "#F5F4F0" : "var(--ink)"}; margin-bottom: 0.6rem; position: relative; z-index: 1;">
                {d.name}
              </h3>
              <p
                style="font-size: 0.88rem; line-height: 1.7; color: ${i === 2 ? "#6B6A65" : "var(--ink-muted)"}; max-width: 44ch; position: relative; z-index: 1;">
                {d.desc}
              </p>
              <div
                style="font-family: var(--font-mono); font-size: 5rem; font-weight: 600; color: transparent; position: absolute; bottom: -0.4rem; right: 1rem; line-height: 1; -webkit-text-stroke: 1px ${i === 2 ? "#2A2A28" : "rgba(15,15,14,0.15)"}; user-select: none; pointer-events: none;">
                {d.num}
              </div>
            </article>
          ))
        }
      </div>
      <!-- Barra de profundidad -->
      <div
        class="dp"
        style="margin-top: 1.5rem; display: flex; align-items: center; gap: 1rem; font-family: var(--font-mono);">
        <span class="label-tag" style="color: #6B6A65;">Scroll ↓</span>
        <div
          class="dp-track"
          style="flex: 1; height: 1px; background: #2A2A28; position: relative;">
          <div
            class="dp-bar"
            style="height: 2px; background: var(--accent); transform-origin: left; transform: scaleX(0); width: 100%;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion) {
    const run = () => {
      const panels = gsap.utils.toArray(".panel3d");
      if (!panels.length) return;

      // Sin flash: la pila nace profunda y oculta hasta que el scroll la trae
      gsap.set(".panel3d", {
        y: 260,
        opacity: 0,
        rotateX: 24,
        z: -560,
        transformPerspective: 1400,
      });

      const pinEnd = () => "+=" + Math.min(window.innerHeight * 1.6, 1200);

      gsap
        .timeline({
          scrollTrigger: {
            trigger: ".stage3d",
            start: "top 60%",
            end: pinEnd,
            scrub: true,
            pin: ".stage3d",
            anticipatePin: 1,
          },
        })
        // Fase 1: deep-zoom — cada panel nace muy atrás y avanza al frente
        .fromTo(
          ".panel3d",
          {
            y: 260,
            opacity: 0,
            rotateX: 24,
            z: -560,
            transformPerspective: 1400,
          },
          {
            y: (i) => -i * 42,
            opacity: 1,
            rotateX: 0,
            z: 0,
            zIndex: (_) => 9,
            ease: "none",
            stagger: 0.28,
          },
          0,
        )
        // Fase 2: cada panel rota en su propio eje (deep-dive al frente)
        .fromTo(
          ".panel3d",
          { rotateY: 0 },
          {
            rotateY: (i) => (i % 2 === 0 ? 14 : -14),
            duration: 1,
            ease: "power2.inOut",
          },
          0.5,
        )
        .to(
          ".panel3d",
          {
            rotateY: 0,
            stagger: 0.15,
            ease: "power2.inOut",
          },
          1.1,
        );

      // Contador de profundidad
      const bar = document.querySelector(".dp-bar") as HTMLElement;
      if (bar) {
        gsap.fromTo(
          bar,
          { scaleX: 0 },
          {
            scaleX: 1,
            ease: "none",
            scrollTrigger: {
              trigger: ".stage3d",
              start: "top 60%",
              end: pinEnd(),
              scrub: true,
            },
          },
        );
      }

      // Tilt 3D con el mouse (sobre la pila, el stage queda anclado por GSAP)
      const stack = document.querySelector(".stack3d") as HTMLElement;
      if (stack) {
        stack.addEventListener("pointermove", (e) => {
          const r = stack.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          gsap.to(stack, {
            rotationY: x * 9,
            rotationX: -y * 9,
            transformPerspective: 1400,
            duration: 0.4,
            ease: "power2.out",
          });
        });
        stack.addEventListener("pointerleave", () => {
          gsap.to(stack, {
            rotationY: 0,
            rotationX: 0,
            duration: 0.5,
            ease: "power2.out",
          });
        });
      }
    };

    if (document.readyState !== "loading") run();
    else document.addEventListener("DOMContentLoaded", run);
  }
</script>

<style>
  .stage3d {
    perspective: 1000px;
    perspective-origin: 50% 0%;
    padding: 2rem 0 4rem;
    will-change: transform;
  }
  .stack3d {
    position: relative;
    max-width: 640px;
  }
  .panel3d {
    position: relative;
    border: 1px solid var(--border-dark);
    padding: 2.25rem 2rem;
    margin-bottom: 1rem;
    overflow: hidden;
    will-change: transform;
  }
  @media (max-width: 768px) {
    .showcase3d {
      padding: 3.5rem 1.25rem !important;
    }
  }
</style>